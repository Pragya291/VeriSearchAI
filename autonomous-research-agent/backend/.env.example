# Application Settings
APP_NAME="Autonomous Research & Fact-Checking Agent"
ENV="development"
DEBUG=True

# API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# Authentication
AUTH_SESSION_DAYS=14
# Set to True when serving the frontend over HTTPS.
AUTH_COOKIE_SECURE=False

# Firebase Credentials (Option 1: Individual Environment Variables)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Credentials (Option 2: Path to JSON Key File)
# FIREBASE_CREDENTIALS_FILE="firebase-credentials.json"

# CORS Frontend URL (React frontend)
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

